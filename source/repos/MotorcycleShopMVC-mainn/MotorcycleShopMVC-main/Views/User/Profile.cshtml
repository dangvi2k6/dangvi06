@model MotorcycleShopMVC.Models.ViewModels.UserProfileViewModel
@{
    ViewData["Title"] = "Tài khoản của tôi";
    var avatar = string.IsNullOrWhiteSpace(Model.AvatarPath) ? "/images/default-avatar.png" : Model.AvatarPath;
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <h2 class="mb-1">Hồ Sơ Của Tôi</h2>
            <p class="text-muted">Quản lý thông tin hồ sơ để bảo mật tài khoản</p>
            <hr />
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <form asp-action="Profile" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()


                <div class="mb-4 row align-items-center">
                    <label class="col-sm-3 col-form-label">Tên</label>
                    <div class="col-sm-9">
                        <input asp-for="FullName" class="form-control" />
                    </div>
                </div>

                <div class="mb-4 row align-items-center">
                    <label class="col-sm-3 col-form-label">Email</label>
                    <div class="col-sm-9">
                        <input class="form-control" value="@Model.Email" disabled />
                    </div>
                </div>

                <div class="mb-4 row align-items-center">
                    <label class="col-sm-3 col-form-label">Số điện thoại</label>
                    <div class="col-sm-9">
                        <input asp-for="PhoneNumber" class="form-control" />
                    </div>
                </div>

                <div class="mb-4 row align-items-center">
                    <label class="col-sm-3 col-form-label">Địa chỉ</label>
                    <div class="col-sm-9">
                        <input asp-for="Address" class="form-control" />
                    </div>
                </div>

                <div class="mb-4 row align-items-center">
                    <label class="col-sm-3 col-form-label">Giới tính</label>
                    <div class="col-sm-9 d-flex gap-3 align-items-center">
                        <label><input type="radio" asp-for="Gender" value="Nam" /> Nam</label>
                        <label><input type="radio" asp-for="Gender" value="Nữ" /> Nữ</label>
                        <label><input type="radio" asp-for="Gender" value="Khác" /> Khác</label>
                    </div>
                </div>

                <div class="mb-4 row align-items-center">
                    <label class="col-sm-3 col-form-label">Ngày sinh</label>
                    <div class="col-sm-9 d-flex gap-2">
                        <input asp-for="BirthDay" class="form-control" placeholder="Ngày" style="max-width:120px;" />
                        <input asp-for="BirthMonth" class="form-control" placeholder="Tháng" style="max-width:120px;" />
                        <input asp-for="BirthYear" class="form-control" placeholder="Năm" style="max-width:140px;" />
                    </div>
                </div>

                <div class="mb-4 row align-items-center">
                    <label class="col-sm-3 col-form-label">Ảnh đại diện</label>
                    <div class="col-sm-9">
                        <input type="file" id="avatarInput" asp-for="AvatarFile" accept="image/*" class="d-none" />
                        <button type="button" class="btn btn-outline-secondary" id="chooseAvatarBtn">
                            Chọn Ảnh
                        </button>
                        <div class="mt-3">
                            <img id="avatarPreview"
                                 src="@avatar"
                                 alt="Avatar"
                                 class="rounded-circle border"
                                 style="width:150px;height:150px;object-fit:cover;" />
                        </div>
                        <small class="text-muted d-block mt-2">
                            Dung lượng file tối đa 1 MB - Định dạng JPEG, PNG
                        </small>
                    </div>
                </div>
                <button type="submit" class="btn btn-danger px-4">Lưu</button>
            </form>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        const chooseAvatarBtn = document.getElementById("chooseAvatarBtn");
        const avatarInput = document.getElementById("avatarInput");
        const avatarPreview = document.getElementById("avatarPreview");

        chooseAvatarBtn.addEventListener("click", function () {
            avatarInput.click();
        });

        avatarInput.addEventListener("change", function () {
            const file = this.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    avatarPreview.src = e.target.result;
                };
                reader.readAsDataURL(file);
            }
        });
    </script>
}
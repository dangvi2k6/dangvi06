@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="container mt-5">

    <div class="card shadow border-0">

        <div class="card-body p-4">

            <h1 class="fw-bold mb-3">
                Privacy Policy
            </h1>

            <p class="text-muted">
                This Privacy Policy explains how MotorcycleShopMVC collects, uses, and protects your personal information.
            </p>

            <hr />

            <h4>1. Information We Collect</h4>
            <ul>
                <li>Full name</li>
                <li>Email address</li>
                <li>Phone number (optional)</li>
                <li>Shipping address (for orders)</li>
                <li>Account activity (orders, wishlist, reviews)</li>
            </ul>

            <hr />

            <h4>2. How We Use Your Data</h4>
            <ul>
                <li>To process orders and payments</li>
                <li>To manage user accounts</li>
                <li>To improve system experience</li>
                <li>To send notifications related to orders</li>
            </ul>

            <hr />

            <h4>3. Data Protection</h4>
            <p>
                We use authentication cookies and secure password hashing to protect your account.
                Sensitive data such as passwords are never stored in plain text.
            </p>

            <hr />

            <h4>4. Account Security</h4>
            <p>
                Users are responsible for maintaining the confidentiality of their login credentials.
                Admin has the right to lock accounts in case of suspicious activity or violation of policies.
            </p>

            <hr />

            <h4>5. Data Sharing</h4>
            <p>
                We do not sell or share your personal data with third parties except when required for payment processing or legal compliance.
            </p>

            <hr />

            <h4>6. Contact</h4>
            <p>
                If you have any questions about this Privacy Policy, please contact system administrator.
            </p>

        </div>

    </div>

</div>
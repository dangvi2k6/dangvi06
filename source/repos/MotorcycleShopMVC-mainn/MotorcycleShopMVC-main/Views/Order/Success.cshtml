﻿@{
ViewData["Title"] = "Đặt hàng thành công";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="card shadow-sm border-success">
                <div class="card-body py-5">
                    <i class="text-success fs-1 mb-3">✔</i> <h2 class="text-success mb-3">Đặt hàng thành công!</h2>
                    <p class="lead">Cảm ơn bạn đã mua sắm tại hệ thống của chúng tôi.</p>
                    
                    <div class="alert alert-light border mt-4">
                        Mã đơn hàng của bạn là: <strong>#@ViewBag.OrderId</strong>
                    </div>

                    <p class="text-muted small">Chúng tôi sẽ sớm liên hệ với bạn để xác nhận đơn hàng.</p>
                    
                    <div class="mt-4">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-primary me-2">Về trang chủ</a>
                        <a asp-controller="Motorcycle" asp-action="Index" class="btn btn-outline-primary">Tiếp tục mua sắm</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>